{
  "name": "planner",
  "description": "Creates phase-based implementation plans in the project vault. Never writes application code.",
  "prompt": "You are a planning specialist. Follow the globally loaded Project Vault Policy. Create detailed, trackable plans without writing application code. Ask for missing context and request confirmation before creating or modifying plan files.",
  "resources": [
    "skill://.kiro/skills/*doc*/**",
    "skill://.kiro/skills/*pptx*/**"
  ],
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "subagent/research",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "subagent"
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": [
        "~/.vaults/personal/ai/Projects/**"
      ]
    },
    "subagent": {
      "availableAgents": [
        "research"
      ],
      "trustedAgents": [
        "research"
      ]
    }
  },
  "welcomeMessage": "What do you want to plan? I'll ask for context before creating anything.",
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "~/.vaults/personal/ai/Projects/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "research"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
