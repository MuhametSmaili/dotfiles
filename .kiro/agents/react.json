{
  "name": "react",
  "description": "Specialized agent for React development with TypeScript, modern patterns, and best practices",
  "prompt": "You are a React specialist focused on modern React development with TypeScript. Prioritize functional components, hooks, performance optimization, and accessibility. Use current best practices for state management, testing, and component architecture.",
  "resources": [
    "file://package.json",
    "file://tsconfig.json",
    "file://~/.kiro/custom/rules/*.md",
    "file://.agent/tasks/IMPLEMENTATION_PLAN.md",
    "skill://.kiro/skills/*react*/SKILL.md"
  ],
  "tools": [
    "*"
  ],
  "toolsSettings": {
    "fs_read": {
      "deniedPaths": [
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/secrets/**"
      ]
    },
    "fs_write": {
      "deniedPaths": [
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/secrets/**"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "ast-grep.*",
        "awk.*",
        "biome.*",
        "bun.*",
        "cargo.*",
        "cat.*",
        "cloc.*",
        "cp.*",
        "date.*",
        "diff.*",
        "fd.*",
        "find.*",
        "fnm.*",
        "fzf.*",
        "git.*",
        "go .*",
        "grep.*",
        "rg.*",
        "gsed.*",
        "head.*",
        "jq.*",
        "ls.*",
        "mkdir.*",
        "npm.*",
        "pnpm.*",
        "prettier.*",
        "pwd",
        "sed.*",
        "sg.*",
        "shellcheck.*",
        "sort.*",
        "stow.*",
        "stylua.*",
        "tail.*",
        "tar.*",
        "touch.*",
        "tr.*",
        "tree.*",
        "tsc.*",
        "turbo.*",
        "uniq.*",
        "unzip.*",
        "vite.*",
        "vitest.*",
        "wc.*",
        "which.*",
        "xargs.*",
        "yarn.*",
        "zip.*",
        "zoxide.*"
      ],
      "deniedCommands": [
        "git push.*"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "research"
      ],
      "trustedAgents": [
        "research"
      ]
    }
  },
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "format_changed_files"
      },
      "timeout": 3
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "ast-grep*",
          "awk*",
          "biome*",
          "bun*",
          "cargo*",
          "cat*",
          "cloc*",
          "cp*",
          "date*",
          "diff*",
          "fd*",
          "find*",
          "fnm*",
          "fzf*",
          "git*",
          "go *",
          "grep*",
          "rg*",
          "gsed*",
          "head*",
          "jq*",
          "ls*",
          "mkdir*",
          "npm*",
          "pnpm*",
          "prettier*",
          "pwd",
          "sed*",
          "sg*",
          "shellcheck*",
          "sort*",
          "stow*",
          "stylua*",
          "tail*",
          "tar*",
          "touch*",
          "tr*",
          "tree*",
          "tsc*",
          "turbo*",
          "uniq*",
          "unzip*",
          "vite*",
          "vitest*",
          "wc*",
          "which*",
          "xargs*",
          "yarn*",
          "zip*",
          "zoxide*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/*.env",
          "**/*.env/**",
          "**/*.env.*",
          "**/*.env.*/**",
          "**/*.envrc",
          "**/*.envrc/**",
          "**/secrets/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/*.env",
          "**/*.env.*",
          "**/*.envrc",
          "**/secrets/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "research"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "./**"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
