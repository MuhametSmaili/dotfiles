{
  "name": "go",
  "description": "Go specialist — idiomatic Go, API design, concurrency, and Kubernetes",
  "prompt": "You are a Go specialist. Write idiomatic Go following stdlib conventions. Prioritize simplicity, proper error handling, concurrency patterns, and clean package structure. You also handle API design (REST/gRPC) and Kubernetes manifests when working on Go services.",
  "resources": [
    "file://go.mod",
    "file://go.sum",
    "file://Dockerfile",
    "file://~/.kiro/custom/rules/*.md",
    "file://.agent/tasks/IMPLEMENTATION_PLAN.md",
    "skill://.kiro/skills/*golang*/**",
    "skill://.kiro/skills/*api-design*/**",
    "skill://.kiro/skills/*kubernetes*/**"
  ],
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "shell",
    "subagent/research",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "subagent"
  ],
  "toolsSettings": {
    "fs_write": {
      "deniedPaths": [
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/secrets/**"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "go .*",
        "gofmt.*",
        "golangci-lint.*",
        "make.*",
        "docker.*",
        "kubectl.*"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "research"
      ],
      "trustedAgents": [
        "research"
      ]
    }
  },
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "format_changed_files"
      },
      "timeout": 3
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "go *",
          "gofmt*",
          "golangci-lint*",
          "make*",
          "docker*",
          "kubectl*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/*.env",
          "**/*.env.*",
          "**/*.envrc",
          "**/secrets/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "research"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:c440da02ed0aa63917d1797629bcbdcf98908a3303f1c1f8d13121a3d0c5eb49",
    "source": "sha256:4c339391b5320211ebd09eac2674b25964915868aff410cbb01a85f4d44a6714"
  }
}
