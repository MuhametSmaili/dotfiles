{
  "name": "node",
  "description": "Node/Bun backend specialist — NestJS, Express, Fastify, Hono, and JS/TS backend patterns",
  "prompt": "You are a Node.js/Bun backend specialist. Focus on server-side TypeScript/JavaScript with frameworks like NestJS, Express, Fastify, and Hono. Prioritize type safety, proper error handling, middleware patterns, dependency injection, and clean architecture.",
  "resources": [
    "file://package.json",
    "file://tsconfig.json",
    "file://Dockerfile",
    "file://~/.kiro/custom/rules/*.md",
    "file://.agent/tasks/IMPLEMENTATION_PLAN.md",
    "skill://.kiro/skills/*nestjs*/**",
    "skill://.kiro/skills/*node*/**",
    "skill://.kiro/skills/*api-design*/**"
  ],
  "tools": [
    "code",
    "glob",
    "grep",
    "read",
    "shell",
    "subagent/research",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "code",
    "subagent"
  ],
  "toolsSettings": {
    "fs_write": {
      "deniedPaths": [
        "**/*.env",
        "**/*.env.*",
        "**/*.envrc",
        "**/secrets/**"
      ]
    },
    "execute_bash": {
      "allowedCommands": [
        "npm.*",
        "pnpm.*",
        "bun.*",
        "yarn.*",
        "npx.*",
        "tsc.*",
        "node.*",
        "make.*",
        "docker.*"
      ],
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "research"
      ],
      "trustedAgents": [
        "research"
      ]
    }
  },
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "write",
      "action": {
        "type": "command",
        "command": "format_changed_files"
      },
      "timeout": 3
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "npm*",
          "pnpm*",
          "bun*",
          "yarn*",
          "npx*",
          "tsc*",
          "node*",
          "make*",
          "docker*"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/*.env",
          "**/*.env.*",
          "**/*.envrc",
          "**/secrets/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "research"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:ab902ee678a497f6694bfb090255b7103a9aa7189a8cd69ed93dc0e9969a954c",
    "source": "sha256:1a00ead71e387d8706241b6cd10d9ea780f34d0c9e22cd73e8e8cb45842865c0"
  }
}
