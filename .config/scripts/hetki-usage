#!/usr/bin/env bash
# hetki-usage: sample the hetki status daemon and picker use during the day.
#
#   hetki-usage start [seconds]   sample in the background (default every 60 s)
#   hetki-usage stop              stop sampling
#   hetki-usage status            show whether sampling runs and where data goes
#   hetki-usage summary [day|all] summarize a day (YYYY-MM-DD, default today) or all days
#   hetki-usage follow            print new samples as they are written
#   hetki-usage sample            take one sample now and print it
#
# Data: one CSV per day in ${XDG_STATE_HOME:-~/.local/state}/hetki/usage/.
# It observes the tmux server selected by your environment, like
# `hetki service status`. It only reads; it never starts or stops anything.

set -u

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
data_dir="$state_home/hetki/usage"
pid_file="$data_dir/sampler.pid"
frecency_file="$state_home/hetki/frecency.json"
header="time,daemon_pid,instance,daemon_rss_kib,daemon_cpu_s,daemon_cpu_pct,tmux_pid,tmux_rss_kib,tmux_cpu_s,sessions,panes,pickers_open,navigations"

# ps prints cumulative CPU as [[D-]HH:]MM:SS[.ss]; convert it to seconds.
cpu_seconds() {
	ps -o time= -p "$1" 2>/dev/null | awk '{
		t = $1; days = 0
		if (index(t, "-")) { split(t, d, "-"); days = d[1]; t = d[2] }
		n = split(t, p, ":"); s = 0
		for (i = 1; i <= n; i++) s = s * 60 + p[i]
		printf "%.2f", s + days * 86400
	}'
}

rss_kib() {
	ps -o rss= -p "$1" 2>/dev/null | tr -d ' '
}

# Picker processes are hetki invoked without a subcommand (flags allowed).
pickers_open() {
	ps -A -o args= 2>/dev/null | awk '{
		n = split($1, path, "/")
		if (path[n] == "hetki" && ($2 == "" || substr($2, 1, 1) == "-")) count++
	} END { print count + 0 }'
}

# Each successful picker navigation adds 1 to a frecency rank, so the rank
# sum grows by the number of navigations (until rare aging rescales it).
navigations() {
	[ -r "$frecency_file" ] || { echo 0; return; }
	grep -o '"rank":[0-9.]*' "$frecency_file" | awk -F: '{ s += $2 } END { printf "%.0f", s }'
}

day_file() {
	echo "$data_dir/$(date +%Y-%m-%d).csv"
}

# Prints one CSV row; reads the previous row to compute the CPU percentage.
sample() {
	local now status daemon instance socket rss cpu pct=""
	local tmux_pid="" tmux_rss="" tmux_cpu="" sessions="" panes=""
	now=$(date +%s)
	status=$(hetki service status 2>/dev/null)
	daemon=$(printf '%s\n' "$status" | awk -F': ' '/^Daemon PID:/ { print $2 }')
	instance=$(printf '%s\n' "$status" | awk -F': ' '/^Instance:/ { print $2 }')
	socket=$(printf '%s\n' "$status" | awk -F': ' '/^Tmux socket:/ { print $2 }')

	if [ -n "$daemon" ]; then
		rss=$(rss_kib "$daemon")
		cpu=$(cpu_seconds "$daemon")
	else
		rss="" cpu=""
	fi

	if [ -n "$socket" ]; then
		tmux_pid=$(tmux -S "$socket" display-message -p '#{pid}' 2>/dev/null)
		sessions=$(tmux -S "$socket" list-sessions 2>/dev/null | wc -l | tr -d ' ')
		panes=$(tmux -S "$socket" list-panes -a 2>/dev/null | wc -l | tr -d ' ')
		if [ -n "$tmux_pid" ]; then
			tmux_rss=$(rss_kib "$tmux_pid")
			tmux_cpu=$(cpu_seconds "$tmux_pid")
		fi
	fi

	local file previous
	file=$(day_file)
	if [ -n "$cpu" ] && [ -s "$file" ]; then
		previous=$(tail -n 1 "$file")
		pct=$(printf '%s\n' "$previous" | awk -F, -v now="$now" -v pid="$daemon" -v cpu="$cpu" '
			$2 == pid && now > $1 && $5 != "" { printf "%.2f", (cpu - $5) * 100 / (now - $1) }')
	fi

	echo "$now,$daemon,$instance,$rss,$cpu,$pct,$tmux_pid,$tmux_rss,$tmux_cpu,$sessions,$panes,$(pickers_open),$(navigations)"
}

record() {
	local file
	file=$(day_file)
	[ -s "$file" ] || echo "$header" > "$file"
	sample >> "$file"
}

loop() {
	local interval="$1"
	trap 'rm -f "$pid_file"; exit 0' INT TERM
	while :; do
		record
		sleep "$interval" &
		wait $!
	done
}

running_pid() {
	[ -r "$pid_file" ] || return 1
	local pid
	pid=$(cat "$pid_file")
	ps -p "$pid" -o args= 2>/dev/null | grep -q 'hetki-usage __loop' && echo "$pid"
}

cmd_start() {
	local interval="${1:-60}" pid
	case "$interval" in
		'' | *[!0-9]*) echo "interval must be a whole number of seconds" >&2; return 2 ;;
	esac
	mkdir -p "$data_dir"
	if pid=$(running_pid); then
		echo "already sampling (pid $pid)"
		return 0
	fi
	nohup "$0" __loop "$interval" </dev/null >/dev/null 2>&1 &
	echo $! > "$pid_file"
	echo "sampling every ${interval}s (pid $!), writing $(day_file)"
}

cmd_stop() {
	local pid
	if pid=$(running_pid); then
		kill "$pid" && rm -f "$pid_file"
		echo "stopped (pid $pid)"
	else
		rm -f "$pid_file"
		echo "not sampling"
	fi
}

cmd_status() {
	local pid
	if pid=$(running_pid); then
		echo "sampling (pid $pid)"
	else
		echo "not sampling"
	fi
	echo "data: $data_dir"
}

cmd_summary() {
	local which="${1:-$(date +%Y-%m-%d)}" files
	if [ "$which" = all ]; then
		files=$(ls "$data_dir"/*.csv 2>/dev/null)
	else
		files="$data_dir/$which.csv"
	fi
	[ -n "$files" ] && ls $files >/dev/null 2>&1 || { echo "no data for $which" >&2; return 1; }

	awk -F, '
		FNR == 1 { next }
		{
			n++
			if (first == "") first = $1
			last = $1
			if ($2 == "") { down++; next }
			if ($3 != instance) { if (instance != "") restarts++; instance = $3 }
			rss = $4 / 1024
			if (min == "" || rss < min) min = rss
			if (rss > max) max = rss
			sum += rss; up++
			if ($6 != "") { pct += $6; pcts++; if ($6 > maxpct) maxpct = $6 }
			if ($2 == pid && $5 >= cpu) used += $5 - cpu
			pid = $2; cpu = $5
			tmux = $8 / 1024; if (tmux > tmuxmax) tmuxmax = tmux
			if ($10 > sessions) sessions = $10
			if ($11 > panes) panes = $11
			if ($12 > 0) open++
			if (nav != "" && $13 >= nav) navs += $13 - nav
			nav = $13
		}
		END {
			if (n == 0) { print "no samples"; exit }
			printf "samples:           %d over %.1f h\n", n, (last - first) / 3600
			printf "daemon down:       %d samples\n", down
			printf "daemon restarts:   %d\n", restarts + 0
			if (up) printf "daemon memory:     min %.1f / avg %.1f / max %.1f MiB\n", min, sum / up, max
			if (pcts) printf "daemon CPU:        avg %.2f%% / max %.2f%% of one core\n", pct / pcts, maxpct
			printf "daemon CPU time:   %.1f s\n", used
			printf "tmux server max:   %.1f MiB\n", tmuxmax
			printf "max sessions/panes: %d / %d\n", sessions, panes
			printf "picker open in:    %d samples\n", open + 0
			printf "picker navigations: %d\n", navs + 0
		}' $files
}

case "${1:-}" in
	start) shift; cmd_start "$@" ;;
	stop) cmd_stop ;;
	status) cmd_status ;;
	summary) shift; cmd_summary "$@" ;;
	follow) tail -n 5 -F "$(day_file)" ;;
	sample) sample ;;
	__loop) loop "$2" ;;
	*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
