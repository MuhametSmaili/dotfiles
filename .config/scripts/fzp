#!/usr/bin/env bash
# Runs the fzp binary, rebuilding it from $XDG_CONFIG_HOME/fzp/src when any
# source file is newer. See `fzp --help`.
set -euo pipefail

src="${XDG_CONFIG_HOME:-$HOME/.config}/fzp/src"
bin="${XDG_CACHE_HOME:-$HOME/.cache}/fzp/fzp"

stale() {
	[[ ! -x "$bin" ]] || [[ -n "$(find "$src" \( -name '*.go' -o -name 'go.*' \) -newer "$bin" -print -quit)" ]]
}

build() {
	local go=(go)
	if ! command -v go >/dev/null 2>&1; then
		command -v mise >/dev/null 2>&1 || {
			echo "fzp: Go is required to build $src" >&2
			return 1
		}
		go=(mise x -- go)
	fi

	mkdir -p "$(dirname "$bin")"
	# Build to a private temporary file, so a failed build keeps the previous
	# binary and a concurrent fzp never runs a half-written one.
	local tmp
	tmp="$(mktemp "$bin.XXXXXX")"
	if (cd "$src" && "${go[@]}" build -o "$tmp" .); then
		mv -f "$tmp" "$bin"
	else
		rm -f "$tmp"
		return 1
	fi
}

if stale && ! build; then
	[[ -x "$bin" ]] || exit 1
	echo "fzp: build failed; running the previous binary" >&2
fi

exec "$bin" "$@"
