# Appearance
theme              = light:Catppuccin Latte,dark:Merino Dark
# Lower = more transparent.
background-opacity = 0.75
background-blur    = macos-glass-regular
alpha-blending     = native
palette-generate   = true
palette-harmonious = true
progress-style     = true

# Keep dim text readable.
minimum-contrast = 2
#bold-color       = bright

# Fonts
font-family    = "MonoLisaCode Variable"
font-size      = 16
# Ligatures and glyph variants.
font-feature   = calt, liga
font-feature   = zero, ss14
font-feature   = ss13
font-feature   = ss01, ss11
font-feature   = cv02, cv04, cv05, cv07, cv08, cv09

# Cursor
cursor-style        = block
cursor-style-blink  = false
cursor-invert-fg-bg = false

# Window
macos-titlebar-style = hidden
macos-window-shadow  = true
macos-option-as-alt  = true
window-padding-x       = 5
window-padding-y       = 8
# Split leftover space evenly instead of pushing it to the bottom.
window-padding-balance = equal

# Shell integration
# no-cursor  : keep our configured cursor-style at the prompt
# ssh-env    : forward COLORTERM / TERM_PROGRAM over ssh
# ssh-terminfo : install xterm-ghostty terminfo on remote hosts on first ssh
# sudo       : preserve TERMINFO through sudo so root sessions render correctly
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,sudo

# Clipboard
copy-on-select  = true
clipboard-write = allow
clipboard-read  = allow

# Bell & notifications
# attention : bounce the dock icon while unfocused
# title     : show a bell icon in the tab title until refocused
# border    : flash the surface border on the alerted pane
# system    : play the macOS alert sound (whatever is picked in System Settings)
bell-features = attention,title,border,system

# Native notification when a slow command finishes while Ghostty is not focused.
# Requires OSC 133 prompt marks (provided by shell-integration = detect).
notify-on-command-finish       = unfocused
notify-on-command-finish-after = 30s

# Undo history
# 60s window to reopen a closed split / tab / window with cmd+z.
undo-timeout = 60s

# Quick terminal (Quake-style drop-down)
# Toggled globally with meh+t (ctrl+alt+shift+t) from any app.
# Requires macOS Accessibility permission (System Settings > Privacy & Security).
quick-terminal-position           = top
quick-terminal-size               = 70%
quick-terminal-screen             = main
quick-terminal-animation-duration = 0.15
quick-terminal-autohide           = true
quick-terminal-space-behavior     = move

# Keybindings
# tmux prefix + o: open Hetki (sends ctrl+a then o)
keybind = cmd+p=text:\x01o
# tmux prefix + u: open actions for the active pane
keybind = cmd+k=text:\x01u

# Toggle the quick terminal from anywhere on macOS
# keybind = global:ctrl+alt+shift+t=toggle_quick_terminal
