{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "formatter": true,
  "plugins": ["./local-plugins/usage"],
  "model": "opencode/mimo-v2.6-flash-free",
  "experimental": {
    "policies": [
      { "action": "permission", "resource": "read:*.env", "effect": "deny" },
      { "action": "permission", "resource": "read:*.env.*", "effect": "deny" },
      {
        "action": "permission",
        "resource": "read:*.env.example",
        "effect": "allow"
      },
      { "action": "permission", "resource": "read:*.envrc", "effect": "deny" },
      {
        "action": "permission",
        "resource": "read:secrets/*",
        "effect": "deny"
      },
      { "action": "permission", "resource": "read:*/.ssh/*", "effect": "deny" },
      {
        "action": "permission",
        "resource": "read:*/.zshrc.local",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "edit:*/.zshrc.local",
        "effect": "deny"
      }
    ]
  },
  "references": {
    "project-vault": {
      "path": "~/.vaults/personal/ai/Projects",
      "description": "Supporting project designs, decisions, research, and historical plans. Use Vikunja for task tracking when requested."
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    { "action": "read", "resource": "~/.zshrc.local", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "~/.zshrc.local", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "ast-grep *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "biome *", "effect": "allow" },
    { "action": "shell", "resource": "bun *", "effect": "allow" },
    { "action": "shell", "resource": "cargo *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cloc *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "doggo *", "effect": "allow" },
    { "action": "shell", "resource": "dot *", "effect": "allow" },
    { "action": "shell", "resource": "fd *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "fnm *", "effect": "allow" },
    { "action": "shell", "resource": "fzf *", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "go *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "ripgrep *", "effect": "allow" },
    { "action": "shell", "resource": "gsed *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "prettier *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "sg *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "stow *", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tar *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "tsc *", "effect": "allow" },
    { "action": "shell", "resource": "turbo *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "unzip *", "effect": "allow" },
    { "action": "shell", "resource": "vite *", "effect": "allow" },
    { "action": "shell", "resource": "vitest *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "xargs *", "effect": "allow" },
    { "action": "shell", "resource": "yarn *", "effect": "allow" },
    { "action": "shell", "resource": "z *", "effect": "allow" },
    { "action": "shell", "resource": "zip *", "effect": "allow" },
    { "action": "shell", "resource": "zoxide *", "effect": "allow" },
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "deepwiki_*", "resource": "*", "effect": "deny" },
    { "action": "exa_*", "resource": "*", "effect": "deny" },
    { "action": "vikunja_*", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "research", "effect": "allow" }
      ]
    },
    "general": {
      "mode": "primary",
      "description": "General development orchestrator. Prefer built-in glob/grep for local search and delegate external research.",
      "system": "You are a general development assistant. For local repository searching, prefer the built-in glob and grep tools. When the user needs documentation lookups, web search, or GitHub wiki/repo research, invoke the research subagent and return concise findings with source links.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "research", "effect": "allow" }
      ]
    },
    "research": {
      "mode": "subagent",
      "description": "Search docs, web, and GitHub wikis using MCP tools.",
      "model": "opencode-go/glm-5.3-flash",
      "system": "You are a research agent. For local repository discovery and code search, prefer the built-in glob and grep tools. Use Context7 for library/framework docs and API references. Use DeepWiki for GitHub repository documentation. Use Exa for web search, blog posts, and current information. Pick the right tool for the question. Be concise and return relevant findings with source links.",
      "permissions": [
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "deepwiki_*", "resource": "*", "effect": "allow" },
        { "action": "exa_*", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "vikunja": {
        "type": "remote",
        "url": "{env:VIKUNJA_MCP_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:VIKUNJA_MCP_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "figma": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "disabled": true
      },
      "figwright": {
        "type": "local",
        "command": ["npx", "-y", "@figwright/mcp@latest"],
        "disabled": true
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp"
      },
      "btt": {
        "type": "remote",
        "url": "http://127.0.0.1:64832/mcp"
      }
    }
  }
}
