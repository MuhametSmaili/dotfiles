# SSH private hosts
.ssh/hosts
.ssh/config.work
.ssh/config.work.*
.ssh/config.local
.ssh/config.local.*
.ssh/*.pub
.ssh/id_*
.ssh/*.pem
.ssh/known_hosts*
.ssh/1Password/
.config/git/config.local
.config/tmux/plugins
.zshrc.local

.config/gh/hosts.yml

# Override global gitignore — track .kiro/ in dotfiles
!.kiro/
!.claude/
!.pi/

# Kiro CLI runtime files (still ignore these)
.kiro/.cli_bash_history
.kiro/prompts
.kiro/settings/lsp.json
