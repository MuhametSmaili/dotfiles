# SSH private hosts
.ssh/hosts
.ssh/config.work
.ssh/config.work.*
.ssh/config.local
.ssh/config.local.*
.ssh/*.pub
.ssh/id_*
.ssh/*.pem
.ssh/known_hosts*
.ssh/1Password/
.config/git/config.local
.config/tmux/plugins
.zshrc.local

.config/gh/hosts.yml

# Override global gitignore for tracked agent configuration directories
!.kiro/
!.claude/
!.pi/

# Kiro: track only agent definitions and explicit portable settings
/.kiro/*
!/.kiro/agents/
!/.kiro/settings/
/.kiro/agents/*
!/.kiro/agents/*.json
/.kiro/settings/*
!/.kiro/settings/cli.json
!/.kiro/settings/mcp.json
